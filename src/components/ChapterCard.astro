---
/**
 * A Starlight `<Card>` that is actually a link.
 *
 * Starlight's own `<Card>` has no `href`, so on the splash page the cards
 * animated on hover but did nothing on click — the classic "why does this
 * move if it isn't a button?" dead end.
 *
 * Accessibility approach (mirrors Starlight's own `<LinkCard>`, which cites
 * withastro/starlight#487): the `<a>` wraps ONLY the title, and a
 * `::before` pseudo-element stretches to cover the whole card. That gives:
 *
 * - a concise accessible name — screen readers announce "Core pipeline
 *   (01–06), link", not the entire card body as link text (which is what
 *   naively wrapping the whole card in an `<a>` would produce);
 * - one tab stop per card rather than one per interactive descendant;
 * - the full card as a pointer/touch target.
 *
 * The known trade-off of the stretched-link pattern is that body text inside
 * the card is no longer selectable. Accepted here — these are navigation
 * cards, and it is the same trade-off upstream `<LinkCard>` makes.
 */
import type { ComponentProps } from 'astro/types';
import { Icon } from '@astrojs/starlight/components';

interface Props {
	/** Starlight icon name shown in the title row. Decorative — `Icon` marks it `aria-hidden`. */
	icon?: ComponentProps<typeof Icon>['name'];
	title: string;
	/** Destination — the first chapter this card covers. */
	href: string;
}

const { icon, title, href } = Astro.props;
---

<article class="card chapter-card sl-flex">
	<p class="title sl-flex">
		{icon && <Icon name={icon} class="icon" size="1.333em" />}
		<a class="card-link" href={href}><span set:html={title} /></a>
		<Icon name="right-arrow" class="arrow rtl:flip" size="1.1em" />
	</p>
	<div class="body"><slot /></div>
</article>

<style>
	@layer starlight.components {
		/* ── Layout ────────────────────────────────────────────────────────────
		   Mirrors Starlight's Card.astro so this sits in a <CardGrid> beside
		   stock cards without visual drift. Border/shadow/radius/background
		   come from custom.css's `article.card` sticker theme. */
		.card {
			--sl-card-border: var(--sl-color-purple);
			--sl-card-bg: var(--sl-color-purple-low);
			border: 1px solid var(--sl-color-gray-5);
			background-color: var(--sl-color-black);
			padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
			flex-direction: column;
			gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
		}
		/* Accent palette by grid position — copied from Card.astro verbatim
		   (including its 4n+1 / 4n+5 overlap) so colours match stock cards. */
		.card:nth-child(4n + 1) {
			--sl-card-border: var(--sl-color-orange);
			--sl-card-bg: var(--sl-color-orange-low);
		}
		.card:nth-child(4n + 3) {
			--sl-card-border: var(--sl-color-green);
			--sl-card-bg: var(--sl-color-green-low);
		}
		.card:nth-child(4n + 4) {
			--sl-card-border: var(--sl-color-red);
			--sl-card-bg: var(--sl-color-red-low);
		}
		.card:nth-child(4n + 5) {
			--sl-card-border: var(--sl-color-blue);
			--sl-card-bg: var(--sl-color-blue-low);
		}
		.title {
			font-weight: 600;
			font-size: var(--sl-text-h4);
			color: var(--sl-color-white);
			line-height: var(--sl-line-height-headings);
			gap: 1rem;
			align-items: center;
		}
		.card .icon {
			border: 1px solid var(--sl-card-border);
			background-color: var(--sl-card-bg);
			padding: 0.2em;
			border-radius: 0.25rem;
			flex-shrink: 0;
		}
		.card .body {
			margin: 0;
			font-size: clamp(var(--sl-text-sm), calc(0.5rem + 1vw), var(--sl-text-body));
		}

		/* ── Link behaviour ───────────────────────────────────────────────── */
		.chapter-card {
			position: relative;
			cursor: pointer;
			--card-accent: var(--cg-terracotta, #9d4313);
		}
		:root[data-theme='dark'] .chapter-card {
			--card-accent: var(--cg-terracotta-lt, #f0824e);
		}

		.card-link {
			color: inherit;
			text-decoration: none;
		}
		/* Stretched hit area — see the component doc comment above. */
		.card-link::before {
			content: '';
			position: absolute;
			inset: 0;
		}
		/* Underline is a non-colour affordance, so the link is still evident
		   to users who cannot distinguish the terracotta hover (WCAG 1.4.1). */
		.chapter-card:hover .card-link {
			text-decoration: underline;
			text-underline-offset: 0.15em;
		}

		.arrow {
			margin-inline-start: auto;
			flex-shrink: 0;
			color: var(--sl-color-gray-3);
			transition:
				transform 0.18s ease,
				color 0.18s ease;
		}
		.chapter-card:hover .arrow {
			transform: translateX(0.25em);
			color: var(--card-accent);
		}

		/* ── Focus ────────────────────────────────────────────────────────────
		   Ring the whole card, not just the title, so keyboard focus matches
		   the visible hit area. Base rule stands alone so browsers without
		   :has() still get a visible indicator rather than none. */
		.card-link:focus-visible {
			outline: 3px solid var(--card-accent);
			outline-offset: 2px;
			border-radius: 2px;
		}
		@supports selector(:has(*)) {
			.chapter-card:has(.card-link:focus-visible) {
				outline: 3px solid var(--card-accent);
				outline-offset: 4px;
			}
			.chapter-card:has(.card-link:focus-visible) .card-link:focus-visible {
				outline: none;
			}
		}

		/* ── Reduced motion (WCAG 2.3.3) ──────────────────────────────────── */
		@media (prefers-reduced-motion: reduce) {
			.arrow {
				transition: none;
			}
			.chapter-card:hover .arrow {
				transform: none;
			}
		}
	}
</style>
